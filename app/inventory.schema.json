{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "inventory.schema.json",
  "title": "Application tracker saved inventory (schemaVersion 1)",
  "description": "Saved jobs.json. Status/history/application fields are user-owned and must never be supplied or overwritten by discovery batches.",
  "type": "object",
  "required": [
    "schemaVersion",
    "jobs"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "jobs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "groupColours": {
      "type": "object",
      "description": "Automatic tracker display metadata; agents must not edit."
    }
  },
  "additionalProperties": true,
  "$defs": {
    "record": {
      "type": "object",
      "required": [
        "id",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "New",
            "Shortlisted",
            "Applied",
            "Interview",
            "Offer",
            "Rejected",
            "Withdrawn",
            "Dismissed"
          ]
        },
        "company": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "group": {
          "type": "string",
          "maxLength": 100
        },
        "countries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        },
        "applicationDate": {
          "type": "string",
          "description": "Actual application date, YYYY-MM-DD, or empty when unknown."
        },
        "applicationStatusText": {
          "type": "string",
          "description": "Complete manual replacement for generated status wording. An empty string is intentionally blank; an absent field uses generated history."
        },
        "statusHistory": {
          "type": "array",
          "maxItems": 1000,
          "description": "Dated events from the earlier history representation, retained for compatibility.",
          "items": {
            "$ref": "#/$defs/statusEvent"
          }
        },
        "interviewDate": {
          "type": "string",
          "pattern": "^(?:|[0-9]{4}-[0-9]{2}-[0-9]{2})$",
          "description": "Interview date. Empty means unknown or unset."
        },
        "interviewOutcomeDate": {
          "type": "string",
          "pattern": "^(?:|[0-9]{4}-[0-9]{2}-[0-9]{2})$",
          "description": "Rejection or withdrawal date after interview. Empty means unknown or unset."
        },
        "offerDate": {
          "type": "string",
          "pattern": "^(?:|[0-9]{4}-[0-9]{2}-[0-9]{2})$",
          "description": "Offer date. Empty means unknown or unset."
        },
        "interviewOutcome": {
          "enum": [
            "",
            "Rejected",
            "Offer",
            "Withdrawn"
          ],
          "description": "Current interview outcome. While primary status is Interview, this determines the filter status."
        }
      },
      "additionalProperties": true
    },
    "statusEvent": {
      "type": "object",
      "required": [
        "id",
        "status",
        "date"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "status": {
          "enum": [
            "New",
            "Shortlisted",
            "Applied",
            "Interview",
            "Offer",
            "Rejected",
            "Withdrawn",
            "Dismissed"
          ]
        },
        "date": {
          "type": "string",
          "pattern": "^(?:|[0-9]{4}-[0-9]{2}-[0-9]{2})$",
          "description": "Stage date. Empty is permitted for a genuinely unknown legacy date; runtime also validates calendar dates."
        }
      },
      "additionalProperties": false
    }
  }
}
